---
export interface FaqItem {
  question: string;
  answer: string;
}
export interface Props {
  faqs: FaqItem[];
  heading?: string;
  /** Emit FAQPage JSON-LD for SEO. */
  schema?: boolean;
}
const { faqs, heading = 'Frequently asked questions', schema = true } = Astro.props;

const jsonLd = schema
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;
---

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />}

<section class="faq" aria-label="Frequently asked questions">
  <h2 class="faq__heading">{heading}</h2>
  <div class="faq__list">
    {
      faqs.map((f, i) => (
        <details class="faq__item" open={i === 0}>
          <summary>
            <span>{f.question}</span>
            <span class="faq__chev" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </span>
          </summary>
          <div class="faq__answer">
            <p>{f.answer}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq__heading {
    font-size: var(--step-2);
    margin-bottom: var(--space-m);
  }
  .faq__list {
    border-top: 1px solid var(--border-color);
  }
  .faq__item {
    border-bottom: 1px solid var(--border-color);
  }
  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding: var(--space-s) 0;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    font-size: var(--step-0);
    color: var(--text);
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__chev {
    flex-shrink: 0;
    color: var(--teal-dark);
    transition: transform 0.2s var(--ease);
  }
  .faq__item[open] .faq__chev {
    transform: rotate(180deg);
  }
  .faq__answer {
    padding: 0 0 var(--space-s);
  }
  .faq__answer p {
    margin: 0;
    color: var(--text-muted);
    max-width: var(--measure);
    line-height: 1.65;
  }
</style>
