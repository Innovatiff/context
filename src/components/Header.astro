---
import { SITE } from '../consts';
import { PRIMARY_NAV } from '../data/navigation';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none">
          <path d="M3 18C7 18 8.5 6 12 6C15.5 6 17 18 21 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M2.6 18H21.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.45"></path>
          <path d="M15.2 18V11.7" stroke="#d97706" stroke-width="1.4" stroke-linecap="round" opacity="0.9"></path>
          <circle cx="15.2" cy="10.4" r="2" fill="#d97706"></circle>
        </svg>
      </span>
      <span class="brand-name">{SITE.name}</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />

    <nav class="site-nav" id="site-nav" aria-label="Primary">
      <ul>
        {
          PRIMARY_NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', { active: isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button
        type="button"
        class="theme-toggle theme-toggle--desktop"
        aria-label="Switch between light and dark theme"
        title="Toggle theme"
      >
        <span class="theme-toggle__icon theme-toggle__icon--light" aria-hidden="true">☀️</span>
        <span class="theme-toggle__icon theme-toggle__icon--dark" aria-hidden="true">🌙</span>
      </button>
      <a href="/assessment" class="btn btn--accent nav-cta">Take the Assessment</a>
    </nav>

    <button
      type="button"
      class="theme-toggle theme-toggle--mobile"
      aria-label="Switch between light and dark theme"
      title="Toggle theme"
    >
      <span class="theme-toggle__icon theme-toggle__icon--light" aria-hidden="true">☀️</span>
      <span class="theme-toggle__icon theme-toggle__icon--dark" aria-hidden="true">🌙</span>
    </button>

    <label
      for="nav-toggle"
      class="nav-burger"
      aria-label="Menu"
      aria-controls="site-nav"
      aria-expanded="false"
    >
      <span></span><span></span><span></span>
    </label>
  </div>
</header>

<script>
  // Theme toggle (one button in the bar on phones, one in the nav on desktop).
  document.querySelectorAll('.theme-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('hp-theme', next); } catch {}
    });
  });

  // Keep aria-expanded in sync with the checkbox-driven mobile menu.
  const navToggle = document.getElementById('nav-toggle') as HTMLInputElement | null;
  const burger = document.querySelector('.nav-burger');
  navToggle?.addEventListener('change', () => {
    burger?.setAttribute('aria-expanded', String(navToggle.checked));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--warm-white) 88%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--border-color);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    min-height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    color: var(--charcoal);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.22rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .brand:hover {
    color: var(--charcoal);
    text-decoration: none;
  }
  .brand-mark {
    color: var(--teal);
    display: inline-flex;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 1.6vw, 1.1rem);
    margin-left: auto;
    min-width: 0;
  }
  .site-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1.5vw, 1.35rem);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .nav-link {
    color: var(--slate-blue);
    font-size: 0.92rem;
    font-weight: 500;
    padding: 0.4rem 0.1rem;
    white-space: nowrap;
  }
  .nav-link:hover {
    color: var(--charcoal);
    text-decoration: none;
  }
  .nav-link.active {
    color: var(--charcoal);
    box-shadow: inset 0 -2px 0 var(--teal);
  }
  .nav-cta {
    padding: 0.58em 1.05em;
    font-size: 0.88rem;
    white-space: nowrap;
  }

  /* Theme toggle: quiet icon button. Desktop shows the in-nav one; phones
     show the in-bar one so it works without opening the menu. */
  .theme-toggle {
    background: none;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    width: 2.1rem;
    height: 2.1rem;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.92rem;
    line-height: 1;
    padding: 0;
  }
  .theme-toggle:hover {
    border-color: var(--teal);
  }
  .theme-toggle--mobile {
    display: none;
  }
  /* Show the icon for the theme you'd switch TO. */
  .theme-toggle__icon--light { display: none; }
  :global([data-theme='dark']) .theme-toggle__icon--light { display: inline; }
  :global([data-theme='dark']) .theme-toggle__icon--dark { display: none; }

  .nav-toggle,
  .nav-burger {
    display: none;
  }

  @media (max-width: 979px) {
    .theme-toggle--desktop {
      display: none;
    }
    .theme-toggle--mobile {
      display: inline-flex;
      margin-left: auto;
    }

    .nav-burger {
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      flex-shrink: 0;
      cursor: pointer;
      border: 1px solid var(--border-color);
      border-radius: 999px;
      margin-right: -0.25rem;
    }
    .nav-burger span {
      display: block;
      width: 16px;
      height: 2px;
      background: var(--text);
      border-radius: 2px;
      transition: transform 0.2s var(--ease), opacity 0.2s var(--ease);
    }

    .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin-left: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border-color);
      padding: var(--space-2xs) var(--space-m) var(--space-m);
      box-shadow: var(--shadow-lg);
      max-height: 0;
      overflow: hidden;
      visibility: hidden;
      transition: max-height 0.28s var(--ease), visibility 0s linear 0.28s;
    }
    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .nav-link {
      display: block;
      padding: 0.95rem 0.15rem;
      border-bottom: 1px solid var(--border-color);
      font-size: 1.04rem;
    }
    .nav-link.active {
      box-shadow: none;
      color: var(--teal-dark);
    }
    .nav-cta {
      margin-top: var(--space-m);
      width: 100%;
      padding: 0.85em 1em;
      font-size: 0.98rem;
    }
    .nav-toggle:checked ~ .site-nav {
      max-height: 85vh;
      visibility: visible;
      transition: max-height 0.28s var(--ease);
    }
    .nav-toggle:checked ~ .nav-burger span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-toggle:checked ~ .nav-burger span:nth-child(2) {
      opacity: 0;
    }
    .nav-toggle:checked ~ .nav-burger span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>
