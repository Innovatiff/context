---
import { SITE } from '../consts';
import { PRIMARY_NAV } from '../data/navigation';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none">
          <path d="M3 18C7 18 8.5 6 12 6C15.5 6 17 18 21 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M2.6 18H21.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.45"></path>
          <path d="M15.2 18V11.7" stroke="#d97706" stroke-width="1.4" stroke-linecap="round" opacity="0.9"></path>
          <circle cx="15.2" cy="10.4" r="2" fill="#d97706"></circle>
        </svg>
      </span>
      <span class="brand-name">{SITE.name}</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav-burger" aria-label="Toggle navigation">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          PRIMARY_NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', { active: isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/assessment" class="btn btn--accent nav-cta">See Where You Stand</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--warm-white) 88%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--border-color);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-height: 66px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--charcoal);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.32rem;
    letter-spacing: -0.02em;
  }
  .brand:hover {
    color: var(--charcoal);
    text-decoration: none;
  }
  .brand-mark {
    color: var(--teal);
    display: inline-flex;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(0.4rem, 1.6vw, 1.4rem);
  }
  .site-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(0.4rem, 1.4vw, 1.1rem);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .nav-link {
    color: var(--slate-blue);
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0.4rem 0.2rem;
    white-space: nowrap;
  }
  .nav-link:hover {
    color: var(--charcoal);
    text-decoration: none;
  }
  .nav-link.active {
    color: var(--charcoal);
    box-shadow: inset 0 -2px 0 var(--teal);
  }
  .nav-cta {
    padding: 0.6em 1em;
    font-size: 0.92rem;
  }

  .nav-toggle,
  .nav-burger {
    display: none;
  }

  @media (max-width: 860px) {
    .nav-burger {
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      cursor: pointer;
      border-radius: var(--radius-sm);
      margin: -0.5rem;
      padding: 0.5rem 0.6rem;
    }
    .nav-burger span {
      display: block;
      height: 2px;
      background: var(--charcoal);
      border-radius: 2px;
      transition: transform 0.2s var(--ease), opacity 0.2s var(--ease);
    }

    .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--warm-white);
      border-bottom: 1px solid var(--border-color);
      padding: var(--space-2xs) var(--space-s) var(--space-s);
      box-shadow: var(--shadow-md);
      max-height: 0;
      overflow: hidden;
      visibility: hidden;
      transition: max-height 0.25s var(--ease), visibility 0s linear 0.25s;
    }
    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .nav-link {
      display: block;
      padding: 0.85rem 0.4rem;
      border-bottom: 1px solid var(--border-color);
      font-size: 1.02rem;
    }
    .nav-link.active {
      box-shadow: none;
      color: var(--teal-dark);
    }
    .nav-cta {
      margin-top: var(--space-s);
      width: 100%;
    }
    .nav-toggle:checked ~ .site-nav {
      max-height: 80vh;
      visibility: visible;
      transition: max-height 0.25s var(--ease);
    }
    .nav-toggle:checked ~ .nav-burger span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-toggle:checked ~ .nav-burger span:nth-child(2) {
      opacity: 0;
    }
    .nav-toggle:checked ~ .nav-burger span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>
