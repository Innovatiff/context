---
/**
 * Data source citation list — appears at the bottom of every research page.
 * Real studies, government data, and academic research only.
 */
export interface Props {
  sources: string[];
  heading?: string;
}
const { sources, heading = 'Data sources' } = Astro.props;
---

<section class="datasources" aria-label="Data sources">
  <h2 class="datasources__heading">{heading}</h2>
  <ol class="datasources__list">
    {sources.map((s) => <li>{s}</li>)}
  </ol>
  <p class="datasources__note faint">
    Figures are drawn from publicly available research, government statistics, and
    peer-reviewed studies. Where research is mixed or evolving, we say so. See our
    <a href="/research-methodology">research methodology</a> for how sources are
    selected and reviewed.
  </p>
</section>

<style>
  .datasources {
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--border-color);
  }
  .datasources__heading {
    font-size: var(--step-0);
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text);
    margin-bottom: var(--space-s);
  }
  .datasources__list {
    margin: 0;
    padding-left: 1.3em;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.86rem;
    line-height: 1.55;
  }
  .datasources__list li {
    padding-left: 0.2em;
  }
  .datasources__note {
    margin-top: var(--space-m);
    line-height: 1.6;
  }
</style>
