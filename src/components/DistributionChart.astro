---
/**
 * A calm, CSS-only horizontal bar chart built from real figures. No JS, no
 * chart library — bar widths are computed from the data at build time. A
 * highlighted bar can mark "you are here" style context.
 */
type Bar = { label: string; value: number; display?: string | null; highlight?: boolean };
type Dist = {
  title?: string | null;
  caption?: string | null;
  unit?: string | null;
  source?: string | null;
  bars: Bar[];
};
export interface Props {
  dist: Dist;
}
const { dist } = Astro.props;
const max = Math.max(...dist.bars.map((b) => Math.abs(b.value)), 0) || 1;
---

<figure class="dist">
  {dist.title && <figcaption class="dist__title">{dist.title}</figcaption>}
  {dist.caption && <p class="dist__caption">{dist.caption}</p>}
  <div class="dist__rows">
    {
      dist.bars.map((b) => (
        <div class={b.highlight ? 'dist__row is-hl' : 'dist__row'}>
          <span class="dist__label">{b.label}</span>
          <span class="dist__track">
            <span class="dist__bar" style={`width:${Math.max(2, (Math.abs(b.value) / max) * 100)}%`} />
          </span>
          <span class="dist__value num">{b.display ?? b.value}{dist.unit ?? ''}</span>
        </div>
      ))
    }
  </div>
  {dist.source && <cite class="dist__source">Source: {dist.source}</cite>}
</figure>

<style>
  .dist {
    margin: var(--space-l) 0;
  }
  .dist__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.35rem;
  }
  .dist__caption {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: var(--space-s);
  }
  .dist__rows {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: var(--space-m);
    background: var(--card-bg, #fff);
  }
  .dist__row {
    display: grid;
    grid-template-columns: minmax(6.5rem, 9rem) 1fr minmax(3.5rem, auto);
    align-items: center;
    gap: 0.75rem;
  }
  .dist__label {
    font-size: 0.86rem;
    color: var(--text-muted);
    line-height: 1.3;
  }
  .dist__track {
    background: var(--surface);
    border-radius: 999px;
    height: 0.85rem;
    overflow: hidden;
  }
  .dist__bar {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--teal);
  }
  .dist__value {
    font-family: var(--font-mono);
    font-size: 0.86rem;
    text-align: right;
    color: var(--text);
    white-space: nowrap;
  }
  .dist__row.is-hl .dist__label { color: var(--amber); font-weight: 600; }
  .dist__row.is-hl .dist__bar { background: var(--amber); }
  .dist__row.is-hl .dist__value { color: var(--amber); font-weight: 600; }
  .dist__source {
    display: block;
    margin-top: 0.7rem;
    font-size: 0.76rem;
    font-style: normal;
    color: var(--footnote);
  }
</style>
