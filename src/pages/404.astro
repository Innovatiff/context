---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you were looking for could not be found."
  path="/404"
  noindex={true}
>
  <div class="container nf">
    <p class="nf__code num">404</p>
    <h1>This page isn’t here.</h1>
    <p class="lede">
      The link may be old, or the page may have moved. Nothing is wrong with you —
      it’s just a missing URL.
    </p>
    <div class="nf__actions">
      <a href="/" class="btn btn--primary">Back to home</a>
      <a href="/research-library" class="btn btn--ghost">Browse the research library</a>
    </div>
  </div>
</BaseLayout>

<style>
  .nf {
    padding-block: var(--space-3xl);
    max-width: 600px;
    text-align: center;
    margin-inline: auto;
  }
  .nf__code {
    font-family: var(--font-mono);
    font-size: 4rem;
    font-weight: 600;
    color: var(--teal);
    line-height: 1;
    margin-bottom: var(--space-s);
  }
  .nf .lede {
    margin: var(--space-s) auto var(--space-l);
  }
  .nf__actions {
    display: flex;
    gap: var(--space-s);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
