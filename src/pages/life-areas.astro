---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { CATEGORIES, TARGET_TOTAL } from '../data/categories';

const insights = await getCollection('insights');
const countByCat = insights.reduce<Record<string, number>>((acc, e) => {
  acc[e.data.category] = (acc[e.data.category] ?? 0) + 1;
  return acc;
}, {});

const core = CATEGORIES.filter((c) => c.coreArea);
const others = CATEGORIES.filter((c) => !c.coreArea);

const liveTotal = Object.values(countByCat).reduce((a, b) => a + b, 0);

// Show a plain count once a category has reached its planned size; otherwise
// keep the "scaling to" framing so the label stays accurate either way.
const cardMeta = (slug: string, target: number) => {
  const n = countByCat[slug] ?? 0;
  return n >= target ? `${n} insight${n === 1 ? '' : 's'}` : `${n} live · scaling to ${target}`;
};
---

<BaseLayout
  title="Life Areas — The Ten Dimensions We Map"
  description="Explore the ten areas of life we place in honest context: money, time, work, relationships, health, purpose, comparison, regret, age, and happiness research."
  path="/life-areas"
>
  <div class="container la-page">
    <Breadcrumbs items={[{ label: 'Life Areas' }]} />
    <header class="la-head">
      <p class="eyebrow">What we map</p>
      <h1>Ten areas. One honest picture.</h1>
      <p class="lede">
        Six of these areas form the core assessment; the others give the
        comparison, regret, life-stage, and happiness research that puts the rest
        in context. Together they make up a library of {liveTotal >= TARGET_TOTAL ? TARGET_TOTAL : liveTotal} research-backed pages.
      </p>
    </header>

    <section class="la-section">
      <h2 class="la-section__title">The six core areas</h2>
      <p class="muted la-section__sub">Covered directly by the assessment.</p>
      <div class="la-grid">
        {
          core.map((c) => (
            <a href={`/${c.slug}`} class={`la-card accent-${c.accent}`}>
              <div class="la-card__top">
                <h3>{c.title}</h3>
                <span class="la-card__count num">{countByCat[c.slug] ?? 0}</span>
              </div>
              <p class="la-card__desc">{c.description.slice(0, 150)}…</p>
              <span class="la-card__meta faint">
                {cardMeta(c.slug, c.targetPages)}
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="la-section">
      <h2 class="la-section__title">Context & research areas</h2>
      <p class="muted la-section__sub">
        How perception, timing, and the evidence base shape the rest.
      </p>
      <div class="la-grid">
        {
          others.map((c) => (
            <a href={`/${c.slug}`} class={`la-card accent-${c.accent}`}>
              <div class="la-card__top">
                <h3>{c.title}</h3>
                <span class="la-card__count num">{countByCat[c.slug] ?? 0}</span>
              </div>
              <p class="la-card__desc">{c.description.slice(0, 150)}…</p>
              <span class="la-card__meta faint">
                {cardMeta(c.slug, c.targetPages)}
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .la-page {
    padding-top: var(--space-l);
  }
  .la-head {
    max-width: 680px;
    margin: var(--space-m) 0 var(--space-2xl);
  }
  .la-head h1 {
    margin: var(--space-s) 0 var(--space-m);
  }
  .la-section {
    margin-bottom: var(--space-2xl);
  }
  .la-section__title {
    font-size: var(--step-2);
    margin-bottom: 0.2rem;
  }
  .la-section__sub {
    margin-bottom: var(--space-l);
  }
  .la-grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .la-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 980px) {
    .la-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .la-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: var(--space-m);
    background: #fff;
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--teal);
    border-radius: var(--radius);
    color: var(--text);
    transition: box-shadow 0.18s var(--ease), transform 0.18s var(--ease);
  }
  .la-card.accent-amber { border-left-color: var(--amber); }
  .la-card.accent-green { border-left-color: var(--green); }
  .la-card.accent-slate { border-left-color: var(--slate-blue); }
  .la-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    text-decoration: none;
    color: var(--text);
  }
  .la-card__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-s);
  }
  .la-card__top h3 {
    font-size: var(--step-1);
    margin: 0;
    line-height: 1.2;
  }
  .la-card__count {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--footnote);
  }
  .la-card__desc {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .la-card__meta {
    margin-top: auto;
  }
</style>
