---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import InsightCard from '../components/InsightCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { CATEGORIES } from '../data/categories';

const insights = await getCollection('insights');
const sorted = [...insights].sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

// Group by category, preserving the CATEGORIES order, only non-empty groups.
const groups = CATEGORIES.map((cat) => ({
  cat,
  items: sorted.filter((e) => e.data.category === cat.slug),
})).filter((g) => g.items.length > 0);
---

<BaseLayout
  title="Research Library — Honest, Data-Backed Answers"
  description="A growing library of plain-language, research-backed answers about money, time, work, relationships, health, and meaning — every page grounded in cited population data."
  path="/research-library"
>
  <div class="container rl-page">
    <Breadcrumbs items={[{ label: 'Research Library' }]} />
    <header class="rl-head">
      <p class="eyebrow">Research Library</p>
      <h1>Honest answers to the questions people quietly carry.</h1>
      <p class="lede">
        {insights.length} in-depth pages so far, each grounded in real population
        data and published research. No self-help filler, no unverifiable claims —
        every figure is cited.
      </p>
      <div class="rl-search">
        <input
          type="search"
          id="rl-search-input"
          placeholder={`Search ${insights.length} questions — try "savings", "friends", "sleep"…`}
          aria-label="Search the research library"
          autocomplete="off"
        />
        <p class="rl-search__count faint" id="rl-search-count" aria-live="polite" hidden></p>
      </div>
      <nav class="rl-jump" aria-label="Jump to category" id="rl-jump">
        {groups.map((g) => <a href={`#${g.cat.slug}`}>{g.cat.shortLabel}</a>)}
      </nav>
    </header>

    {
      groups.map((g, gi) => (
        <section id={g.cat.slug} class="rl-group">
          <div class="rl-group__head">
            <h2>{g.cat.title}</h2>
            <a href={`/${g.cat.slug}`} class="rl-group__link">View area →</a>
          </div>
          <div class="grid grid--3">
            {g.items.map((e) => (
              <InsightCard
                title={e.data.title}
                slug={e.data.slug}
                category={e.data.category}
                teaser={e.data.keyFinding}
              />
            ))}
          </div>
          {gi === 1 && <AdSlot slot="" format="horizontal" />}
        </section>
      ))
    }
    <p class="rl-empty muted" id="rl-empty" hidden>
      No pages match that search. Try a broader word — or browse by
      <a href="/life-areas">life area</a>.
    </p>
  </div>
</BaseLayout>

<script>
  // Progressive-enhancement search: filters the server-rendered cards in place.
  const input = document.getElementById('rl-search-input') as HTMLInputElement | null;
  if (input) {
    const groups = [...document.querySelectorAll<HTMLElement>('.rl-group')];
    const countEl = document.getElementById('rl-search-count')!;
    const emptyEl = document.getElementById('rl-empty')!;
    const jumpNav = document.getElementById('rl-jump')!;
    const cards = groups.flatMap((g) =>
      [...g.querySelectorAll<HTMLElement>('.grid > *')].map((el) => ({
        el, g, text: (el.textContent || '').toLowerCase(),
      }))
    );
    let t: ReturnType<typeof setTimeout>;
    const apply = () => {
      const q = input.value.trim().toLowerCase();
      if (!q) {
        cards.forEach((c) => (c.el.hidden = false));
        groups.forEach((g) => (g.hidden = false));
        countEl.hidden = true;
        emptyEl.hidden = true;
        jumpNav.hidden = false;
        return;
      }
      let shown = 0;
      cards.forEach((c) => {
        const hit = c.text.includes(q);
        c.el.hidden = !hit;
        if (hit) shown++;
      });
      groups.forEach((g) => {
        g.hidden = ![...g.querySelectorAll<HTMLElement>('.grid > *')].some((el) => !el.hidden);
      });
      countEl.hidden = false;
      countEl.textContent = `${shown} page${shown === 1 ? '' : 's'} match`;
      emptyEl.hidden = shown > 0;
      jumpNav.hidden = true;
    };
    input.addEventListener('input', () => { clearTimeout(t); t = setTimeout(apply, 120); });
  }
</script>

<style>
  .rl-page {
    padding-top: var(--space-l);
  }
  .rl-head {
    max-width: 700px;
    margin: var(--space-m) 0 var(--space-2xl);
  }
  .rl-head h1 {
    margin: var(--space-s) 0 var(--space-m);
  }
  .rl-search {
    margin-top: var(--space-l);
  }
  .rl-search input {
    width: 100%;
    max-width: 560px;
    font: inherit;
    font-size: 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--card-bg, #fff);
    color: var(--text);
  }
  .rl-search input:focus {
    outline: 2px solid var(--teal);
    outline-offset: 1px;
    border-color: var(--teal);
  }
  .rl-search__count {
    margin: var(--space-2xs) 0 0;
    font-size: 0.85rem;
  }
  .rl-empty {
    margin: var(--space-l) 0 var(--space-2xl);
  }
  .rl-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--space-l);
  }
  .rl-jump a {
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    color: var(--slate-blue);
    background: var(--card-bg, #fff);
  }
  .rl-jump a:hover {
    border-color: var(--teal);
    color: var(--teal-dark);
    text-decoration: none;
  }
  .rl-group {
    margin-bottom: var(--space-2xl);
    scroll-margin-top: 90px;
  }
  .rl-group__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-bottom: var(--space-m);
    padding-bottom: var(--space-2xs);
    border-bottom: 1px solid var(--border-color);
  }
  .rl-group__head h2 {
    font-size: var(--step-2);
    margin: 0;
  }
  .rl-group__link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--teal-dark);
    white-space: nowrap;
  }
</style>
