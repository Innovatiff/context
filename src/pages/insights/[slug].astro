---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import KeyFindingBox from '../../components/KeyFindingBox.astro';
import KeyTakeaways from '../../components/KeyTakeaways.astro';
import ResearchCallout from '../../components/ResearchCallout.astro';
import PullQuote from '../../components/PullQuote.astro';
import DistributionChart from '../../components/DistributionChart.astro';
import InsightNumbers from '../../components/InsightNumbers.astro';
import ExampleBlock from '../../components/ExampleBlock.astro';
import DataSources from '../../components/DataSources.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import RelatedInsights from '../../components/RelatedInsights.astro';
import DisclaimerBox from '../../components/DisclaimerBox.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getCategory } from '../../data/categories';
import { toParagraphs } from '../../utils/prose';
import { SITE } from '../../consts';

const slugify = (s) =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

export async function getStaticPaths() {
  const insights = await getCollection('insights');
  return insights.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const cat = getCategory(d.category);

// Optional rich modules (composed per page for variety and depth).
const layout = d.layout ?? 'standard';
const numbersFirst = layout === 'data-forward';
const dists = d.distributions ?? [];
const leadDist = dists[0];
const restDists = dists.slice(1);
const tables = d.tables ?? [];
const pulls = d.pullQuotes ?? [];
const extraSections = (d.extraSections ?? []).map((s) => ({
  id: s.id ?? slugify(s.heading),
  heading: s.heading,
  body: toParagraphs(s.body),
}));
const numbersIntro = toParagraphs(d.realNumbersInContext);

const sections = [
  { id: 'data', heading: 'What the data actually shows', body: toParagraphs(d.whatDataShows) },
  {
    id: 'why',
    heading: 'Why this feels different from how it actually is',
    body: toParagraphs(d.whyItFeelsDifferent),
  },
  {
    id: 'do',
    heading: 'What the research says to do about it',
    body: toParagraphs(d.whatResearchSaysToDo),
  },
  {
    id: 'doesnt',
    heading: 'What the research says does not help',
    body: toParagraphs(d.whatDoesNotHelp),
  },
];

// Build the "on this page" nav from the sections/modules actually present.
const navItems = [
  { href: '#data', label: 'What the data shows' },
  ...(numbersFirst ? [{ href: '#numbers', label: 'Real numbers' }] : []),
  { href: '#why', label: 'Why it feels different' },
  { href: '#do', label: 'What helps' },
  { href: '#doesnt', label: "What doesn't help" },
  ...extraSections.map((s) => ({ href: `#${s.id}`, label: s.heading })),
  ...(d.examples && d.examples.length ? [{ href: '#examples', label: 'Real-life examples' }] : []),
  ...(!numbersFirst ? [{ href: '#numbers', label: 'Real numbers' }] : []),
];

const reviewedLabel = (() => {
  const [y, m] = d.lastReviewed.split('-');
  const months = [
    'January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December',
  ];
  return m ? `${months[Number(m) - 1]} ${y}` : y;
})();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.metaDescription,
  about: d.lifeArea,
  articleSection: cat?.title ?? d.lifeArea,
  inLanguage: 'en',
  isAccessibleForFree: true,
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  mainEntityOfPage: new URL(`/insights/${d.slug}`, SITE.url).href,
  dateModified: `${d.lastReviewed}-01`,
  citation: d.dataSources,
};
---

<BaseLayout
  title={d.metaTitle}
  description={d.metaDescription}
  path={`/insights/${d.slug}`}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class:list={['insight', `insight--${layout}`]}>
    <div class="container insight__head">
      <Breadcrumbs
        items={[
          { label: 'Research Library', href: '/research-library' },
          ...(cat ? [{ label: cat.shortLabel, href: `/${cat.slug}` }] : []),
          { label: d.title },
        ]}
      />
      {cat && <a href={`/${cat.slug}`} class={`insight__tag accent-${cat.accent}`}>{cat.lifeArea}</a>}
      <h1 class="insight__title">{d.title}</h1>
    </div>

    <div class="container insight__layout">
      <div class="insight__main">
        <!-- The honest answer first. No preamble. -->
        <KeyFindingBox text={toParagraphs(d.honestAnswer).join(' ')} />

        {d.keyTakeaways && d.keyTakeaways.length > 0 && <KeyTakeaways items={d.keyTakeaways} />}

        <div class="article-body">
          {/* What the data shows */}
          <section id="data">
            <h2>{sections[0].heading}</h2>
            {sections[0].body.map((p) => <p>{p}</p>)}
          </section>

          {/* A chart to break up the prose (standard/narrative); data-forward pulls all numbers up next. */}
          {leadDist && !numbersFirst && <DistributionChart dist={leadDist} />}

          <ResearchCallout kicker="The key finding">
            <p>{d.keyFinding}</p>
          </ResearchCallout>

          {numbersFirst && (
            <InsightNumbers
              intro={numbersIntro}
              stats={d.realNumbers}
              distributions={dists}
              tables={tables}
            />
          )}

          {/* Why it feels different */}
          <section id="why">
            <h2>{sections[1].heading}</h2>
            {sections[1].body.map((p) => <p>{p}</p>)}
          </section>

          {pulls[0] && <PullQuote text={pulls[0].text} source={pulls[0].source} />}

          <AdSlot slot="" format="horizontal" />

          {/* What helps */}
          <section id="do">
            <h2>{sections[2].heading}</h2>
            {sections[2].body.map((p) => <p>{p}</p>)}
          </section>

          {/* What doesn't help */}
          <section id="doesnt">
            <h2>{sections[3].heading}</h2>
            {sections[3].body.map((p) => <p>{p}</p>)}
          </section>

          {pulls[1] && <PullQuote text={pulls[1].text} source={pulls[1].source} />}

          {/* Page-specific sections for unique structure and extra explanation */}
          {extraSections.map((s) => (
            <section id={s.id}>
              <h2>{s.heading}</h2>
              {s.body.map((p) => <p>{p}</p>)}
            </section>
          ))}

          {/* Concrete worked examples */}
          {d.examples && d.examples.length > 0 && <ExampleBlock examples={d.examples} />}

          {/* Real numbers in context (standard/narrative: near the end) */}
          {!numbersFirst && (
            <InsightNumbers
              intro={numbersIntro}
              stats={d.realNumbers}
              distributions={restDists}
              tables={tables}
            />
          )}
        </div>

        <AdSlot slot="" format="horizontal" />

        <FaqAccordion faqs={d.faqs} />

        <AdSlot slot="" format="rectangle" />

        <RelatedInsights slugs={d.relatedInsights} exclude={d.slug} />

        <DataSources sources={d.dataSources} />

        <div class="insight__foot">
          <p class="faint">Last reviewed: {reviewedLabel}</p>
          <DisclaimerBox variant="short" />
        </div>
      </div>

      <aside class="insight__aside" aria-label="On this page">
        <div class="aside-sticky">
          <p class="aside-label">On this page</p>
          <nav class="aside-nav">
            {navItems.map((n) => <a href={n.href}>{n.label}</a>)}
          </nav>
          <AdSlot slot="" format="sidebar" desktopOnly={true} />
          <div class="aside-cta">
            <p>See where you stand across all six areas.</p>
            <a href="/assessment" class="btn btn--accent">Take the assessment</a>
          </div>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .insight__head {
    padding-top: var(--space-l);
  }
  .insight__tag {
    display: inline-block;
    margin: var(--space-m) 0 var(--space-s);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--teal-dark);
  }
  .insight__tag.accent-amber { color: var(--amber); }
  .insight__tag.accent-green { color: var(--green); }
  .insight__tag.accent-slate { color: var(--slate-blue); }
  .insight__tag:hover { text-decoration: underline; }

  .insight__title {
    max-width: 20ch;
    margin-bottom: var(--space-m);
  }

  .insight__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: start;
    padding-bottom: var(--space-2xl);
  }
  @media (min-width: 1040px) {
    .insight__layout {
      grid-template-columns: minmax(0, 1fr) 280px;
    }
  }

  .insight__main {
    min-width: 0;
  }
  .insight__main > :global(.keyfinding) {
    margin-bottom: var(--space-l);
  }

  .insight__foot {
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .insight__aside {
    display: none;
  }
  @media (min-width: 1040px) {
    .insight__aside {
      display: block;
    }
  }
  .aside-sticky {
    position: sticky;
    top: 88px;
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
  .aside-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--footnote);
    margin: 0;
  }
  .aside-nav {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    border-left: 2px solid var(--border-color);
    padding-left: var(--space-s);
  }
  .aside-nav a {
    color: var(--text-muted);
    font-size: 0.88rem;
  }
  .aside-nav a:hover {
    color: var(--teal-dark);
  }
  .aside-cta {
    background: var(--surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: var(--space-m);
  }
  .aside-cta p {
    margin: 0 0 var(--space-s);
    font-size: 0.92rem;
    color: var(--text);
  }
  .aside-cta .btn {
    width: 100%;
  }

  /* ---- Layout variants -------------------------------------------------- */
  /* Narrative: prose-led, roomier rhythm, examples feel primary. */
  .insight--narrative .insight__title {
    max-width: 24ch;
  }
  .insight--narrative .article-body :global(section > p) {
    font-size: 1.03rem;
  }
  .insight--narrative .article-body :global(.examples .example) {
    border-left-width: 4px;
  }
  /* Data-forward: the numbers cluster leads; give it a touch more presence. */
  .insight--data-forward .article-body :global(.insight-numbers) {
    scroll-margin-top: 88px;
  }
  .insight--data-forward .article-body :global(.insight-numbers > h2) {
    color: var(--teal-dark);
  }
</style>
